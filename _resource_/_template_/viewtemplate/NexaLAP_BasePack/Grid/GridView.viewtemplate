<ViewTemplateInfo version="2.0">
  <ViewTemplate id="GridView" viewtype="Grid" description_en="description of the view template" manual="extlib::NexaLAP_BasePack/_manual_/viewtemplates/GridView.md"/>
  <Script version="1.0" type="xscript5.1"><![CDATA[/************************************************************************************************
*  @FileName 	GridView
*  @Creator 	Tobesoft
*  @CreateDate 	2026.01.02
*  @Desction    
*  @Version		1.0.0.0
*************************************************************************************************

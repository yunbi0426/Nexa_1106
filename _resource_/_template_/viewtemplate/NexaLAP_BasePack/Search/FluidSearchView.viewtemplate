  <ViewTemplate id="FluidSearchView" viewtype="Search" description_en="Placed at the top of a three-tier structure as the search view on the contract list inquiry screen." manual="extlib::NexaLAP_BasePack/_manual_/viewtemplates/FluidSearchView.md"/>
  <Script version="1.0" type="xscript5.1"><![CDATA[/************************************************************************************************

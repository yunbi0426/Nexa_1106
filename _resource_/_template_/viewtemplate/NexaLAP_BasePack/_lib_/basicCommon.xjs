	,"datetime" 		: "DateTime"
	,"fromtodate" 		: "FromToDate"
	,"email" 			: "Email"
	,"image" 			: "Image"
	,"label" 			: "Label"
	,"text" 			: "Text"
	,"longtext" 		: "LongText"
	,"multilinetext" 	: "MultiLineText"
	,"password" 		: "Password"
	,"number" 			: "Number"
	,"phone" 			: "Phone"
	,"price" 			: "Price"
	,"select" 			: "Select"
	,"multiSelect" 		: "MultiSelect"
	,"progressbar" 		: "ProgressBar"
	,"TextSearchable" 	: "TextSearchable"
};


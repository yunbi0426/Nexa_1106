	/*---------------------------------------------------------------------------------------------*
	* Function     	: set_viewProperties
	* Return       	: List of view generation attributes (JSON format)
	* Description 	: Defines the attributes applied to the overall view during view generation.
	*---------------------------------------------------------------------------------------------*/
	this.set_viewProperties = function() {
		let sViewAttr = "";
		let oViewAttr = {"attributes" : []};
		let oProperties = {};
		
		oProperties={};
		oProperties.id 				= "infoposition";
		oProperties.displaytext 	= "Info Position";
		oProperties.edittype 		= "Enum";
		oProperties.enumlist 		= this.INFOMATION_POSITION_LIST;
		oProperties.defaultvalue 	= this.INFOMATION_POSITION;
		oProperties.description 	= "Info Position";
		oProperties.group		 	= "info";
		oViewAttr.attributes.push(oProperties);

		oProperties={};
		oProperties.id 				= "spinbuttoncssclass";
		oProperties.displaytext 	= "Spin Button Class";
		oProperties.edittype 		= "String";
		oProperties.defaultvalue 	= this.BUTTON_CSSCLASS;
		oProperties.description 	= "Spin Button Class Id";
		oProperties.group		 	= "paging";
		oViewAttr.attributes.push(oProperties);
		
		oProperties={};
		oProperties.id 				= "pagingposition";
		oProperties.displaytext 	= "Paging Position";
		oProperties.edittype 		= "Enum";
		oProperties.enumlist 		= this.PAGING_POSITION_LIST;
		oProperties.defaultvalue 	= this.PAGING_POSITION;
		oProperties.description 	= "Paging Position";
		oProperties.group		 	= "paging";
		oViewAttr.attributes.push(oProperties);

		 oProperties={};
		 oProperties.id 			= "pagingcnt";
		 oProperties.displaytext 	= "Paging Cnt";
		 oProperties.edittype 		= "Number";
		 oProperties.defaultvalue 	= 10;
		 oProperties.description 	= "Sets the Paging View Count.";
		 oProperties.group		 	= "paging";
		 oViewAttr.attributes.push(oProperties);

		// oProperties={};
		// oProperties.id 				= "fieldWidth";
		// oProperties.displaytext 	= "Field Width";
		// oProperties.edittype 		= "string";
		// oProperties.defaultvalue 	= this.FIELD_WIDTH;
		// oProperties.description 	= "Sets the Component Width value.";
		// oProperties.group		 	= "Field";
		// oViewAttr.attributes.push(oProperties);

		// oProperties={};
		// oProperties.id 				= "layout";
		// oProperties.displaytext 	= "Layout";
		// oProperties.edittype 		= "Layout";
		// oProperties.defaultvalue 	= "";
		// let oUserProperties = {"propertcount" : "1", "properties" : []};
		
		// let oProperty = {};
		// oProperty.id 			= "mergelabel";
		// oProperty.edittype 		= "Boolean";
		// oProperty.defaultvalue 	= "false";
		// oProperty.description 	= "Whether to display a unified label when multiple fields are configured." + "\n" + " - The label is generated based on the first field.";
		// oUserProperties.properties.push(oProperty);
		// oProperties.userproperties 	= oUserProperties;
		// oProperties.description	 	= "Sets the View Layout.";
		//oViewAttr.attributes.push(oProperties);


		oViewAttr["attributecount"] = oViewAttr.attributes.length;
				
		sViewAttr = JSON.stringify(oViewAttr, null, "\t");

		return sViewAttr;
	};

	/*---------------------------------------------------------------------------------------------*
	* Function     : set_fieldProperties
	* Return       : List of field-level attributes for view generation (JSON format)
	* Description  : Defines the attributes applied to each model field during view generation.
